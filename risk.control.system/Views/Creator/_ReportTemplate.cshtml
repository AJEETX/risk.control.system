@using risk.control.system.Helpers
@model ReportTemplate
<div class="row">
	<form id="antiForgeryForm">
		@Html.AntiForgeryToken()
	</form>
	<div class="col-12 text-center">
		<input type="hidden" id="locationCount" value="@Model.LocationReport.Count" />
		<span>
			Template Name :
		</span>
		<strong>@Model.Name (@Model.InvestigationServiceType.Name)</strong>

	</div>
	@foreach (var location in Model.LocationReport)
	{
		<div class="col-12">
			<div class="card h-100 shadow-sm border rounded  collapsed-card">
				<div class="card-header bg-light">
					<div class="card-title location-header-width">
						<div class="form-group">
							<div class="input-group">
								<span class="badge badge-light mt-2" title="Location Name" data-bs-toggle="tooltip">
									<i class="fas fa-map-marker-alt me-2"></i>
									@if (location.IsRequired)
									{
										<span class="required-asterisk" title="Required field" data-bs-toggle="tooltip">*</span>
									}
									else
									{
										<i class="fa fa-asterisk asterik-style-none"></i>
									}
								</span>
								<input type="text" asp-for="@location.LocationName" title="Location Name" data-bs-toggle="tooltip" class="form-control remarks title-name" required placeholder="Location Name" value="@location.LocationName" maxlength="50" />

								<span asp-validation-for="@location.LocationName" class="text-danger"></span>
							</div>
						</div>
					</div>
					<div class="card-tools location-button-mt2">
						 <button type="button" class="btn btn-sm btn-light @location.LocationStatus" data-card-widget="collapse">
							<i class="fas fa-plus"></i>
						</button>
					</div>
				</div>
				<div class="card-body">
                                <div class="row g-3 align-items-start">
                                    <!-- Agent ID -->
                                    <div class="col-md-3 border rounded p-2">
                                        <h6 class="text-muted"><i class="far fa-user"></i> Agent ID</h6>
                                        <ul class="list-unstyled mb-3">
                                            <li class="mb-2">
                                                <div class="border rounded p-2  bg-light">
                                                    <div class="form-check">
                                                        <input disabled class="form-check-input" type="checkbox" id="agent_@location.AgentIdReport!.Id" @(location.AgentIdReport.Selected ? "checked" : "") />
                                                        <input type="hidden" name="AgentIdReport.Selected" value="@(location.AgentIdReport.Selected)" />
                                                        <label class="form-check-label" for="agent_@location.AgentIdReport.Id">
                                                            @if (location.AgentIdReport.Has2Face)
                                                            {
                                                                <i class="fas fa-users text-info me-1"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="far fa-user text-info me-1"></i>
                                                            }
                                                            @location.AgentIdReport.ReportName
                                                            
                                                            @if (location.AgentIdReport.IsRequired)
                                                            {
                                                                <span class="required-asterisk" title="Required field" data-bs-toggle="tooltip">*</span>
                                                            }
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <span class="required-asterisk">
                                                            <input type="checkbox" title="Required field" data-bs-toggle="tooltip"
                                                                   id="isfaceRequiredCheckbox_@location.AgentIdReport.Id"
                                                                   name="face.IsRequired"
                                                                   class="form-check-input" checked disabled
                                                            @(location.AgentIdReport.IsRequired ? "checked" : "") />
                                                            <label class="form-check-label small" for="isfaceRequiredCheckbox_@location.AgentIdReport.Id">
                                                               Is Mandatory Face ?
                                                            </label>
                                                        </span>
                                                    </div>
                                                    <div class="mt-3">
                                                        <label class="form-label fw-bold">Camera Capture Mode</label>
                                                        <div class="d-flex">
                                                            @foreach (CameraCaptureMode captureOption in Enum.GetValues(typeof(CameraCaptureMode)))
                                                            {
                                                                var radioId = $"camera_{location.AgentIdReport.Id}_{captureOption}";
                                                                var isChecked = location.AgentIdReport.CameraCaptureMode == captureOption;
                                                                <div class="form-check form-check-inline me-3">
                                                                    <input class="form-check-input"
                                                                           type="radio"
                                                                           name="SelectedCameraCapture"
                                                                           id="@radioId"
                                                                           value="@captureOption"
                                                                           disabled
                                                                    @(isChecked ? "checked" : "") />
                                                                    <label class="form-check-label small" for="@radioId">
                                                                        @captureOption
                                                                    </label>
                                                                </div>
                                                            }
                                                        </div>
                                                        <input type="hidden" name="AgentIdReport.CameraCaptureMode" value="@location.AgentIdReport.CameraCaptureMode" />
                                                </div>
                                                </div>
                                                </li>
                                        </ul>
                                    </div>
                                    <!-- Face IDs -->
                                    <div class="col-md-3 border rounded p-2">
                                        <h6 class="text-muted"><i class="fas fa-users"></i> Face IDs</h6>
                                        <ul class="list-unstyled mb-3">
                                            @foreach (var face in location.FaceIds ?? new List<FaceIdReport>())
                                            {
                                                <li class="mb-2">
                                                    <div class="border rounded p-2  bg-light">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="face_@face.Id" @(face.Selected ? "checked" : "") />
                                                            <label class="form-check-label" for="face_@face.Id">
                                                                @if (face.Has2Face)
                                                                {
                                                                    <i class="fas fa-users text-info me-1"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="far fa-user text-info me-1"></i>
                                                                }
                                                                @face.ReportName
                                                                
                                                                @* @if (face.IsRequired)
                                                                {
                                                                    <span class="required-asterisk" title="Required field" data-bs-toggle="tooltip">*</span>
                                                                } *@
                                                            </label>
                                                        </div>
                                                        <div class="form-check">
                                                            <span class="required-asterisk">
                                                                <input type="checkbox" title="Required field" data-bs-toggle="tooltip"
                                                                       id="isfaceRequiredCheckbox_@face.Id"
                                                                   name="face.IsRequired"
                                                                   class="form-check-input"
                                                            @(face.IsRequired ? "checked" : "") />
                                                            <label class="form-check-label small" for="isfaceRequiredCheckbox_@face.Id">
                                                                Is Mandatory Face?
                                                            </label>
                                                        </span>
                                                    </div>
                                                            <div class="mt-3">
                                                                <label class="form-label fw-bold">Camera Capture Mode</label>
                                                                <div class="d-flex">
                                                                    @foreach (CameraCaptureMode captureOption in Enum.GetValues(typeof(CameraCaptureMode)))
                                                                    {
                                                                        var radioId = $"camera_face_{face.Id}_{captureOption}";
                                                                        var isChecked = face.CameraCaptureMode == captureOption;
                                                                        <div class="form-check form-check-inline me-3">
                                                                            <input class="form-check-input"
                                                                                   type="radio"
                                                                                   id="@radioId"
                                                                                   name="face_camera_@face.Id"
                                                                                   value="@captureOption"
                                                                            @(isChecked ? "checked" : "") />
                                                                            <label class="form-check-label small" for="@radioId">
                                                                                @captureOption
                                                                            </label>
                                                                        </div>
                                                                    }
                                                                </div>
                                                                <input type="hidden" name="CameraCaptureMode" value="@face.CameraCaptureMode" />
                                                            </div>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                    <!-- Document IDs -->
                                    <div class="col-md-3 border rounded p-2">
                                        <h6 class="text-muted"><i class="far fa-file-alt"></i> Document IDs</h6>
                                        <ul class="list-unstyled mb-3 scrollable-list">
                                            @{
                                                int i = 0;
                                            }
                                            @foreach (var doc in location.DocumentIds ?? new List<DocumentIdReport>())
                                            {
                                                <li class="mb-2">
                                                    <div class="border rounded p-2 bg-light">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="doc_@doc.Id" @(doc.Selected ? "checked" : "") />
                                                            <label class="form-check-label" for="doc_@doc.Id">
                                                                @if (doc.HasBackImage)
                                                                {
                                                                    <i class="fas fa-copy text-muted me-1"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="far fa-file text-muted me-1"></i>
                                                                }
                                                                @doc.ReportName
                                                                @* @if (doc.IsRequired)
                                                                {
                                                                    <span class="required-asterisk" title="Required field" data-bs-toggle="tooltip">*</span>
                                                                } *@
                                                            </label>
                                                        </div>
                                                        <div class="form-check">
                                                            <span class="required-asterisk">
                                                                <input type="checkbox" title="Required field" data-bs-toggle="tooltip"
                                                                       id="isdocRequiredCheckbox_@doc.Id"
                                                                   name="doc.IsRequired"
                                                                   class="form-check-input"
                                                            @(doc.IsRequired ? "checked" : "") />
                                                                <label class="form-check-label small" for="isdocRequiredCheckbox_@doc.Id">
                                                                Is Mandatory Document ?
                                                            </label>
                                                        </span>
                                                    </div>
                                                        <!-- PageCount Radio Buttons with Index -->
                                                        <div class="form-check">
                                                            <span class="text-muted small d-block mb-1">Page Count:</span>
                                                            <div class="d-flex flex-wrap gap-3">
                                                                @foreach (PageCount countOption in Enum.GetValues(typeof(PageCount)))
                                                                {
                                                                    <div class="form-check form-check-inline mb-0">
                                                                        <input class="form-check-input" 
                                                                           type="radio" 
                                                                           name="location.DocumentIds[@i].PageCount" 
                                                                           id="pageCount_@doc.Id.ToString()_@countOption" 
                                                                           value="@countOption" 
                                                                           checked="@(doc.PageCount == countOption)" />
                                                                        <label class="form-check-label small" for="pageCount_@doc.Id.ToString()_@countOption">
                                                                            @countOption.GetEnumDisplayName()
                                                                        </label>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </li>
                                                i++;
                                            }
                                        </ul>
                                    </div>
                                    <!-- Media IDs -->
                                    <div class="col-md-3 border rounded p-2">
                                        <h6 class="text-muted"><i class="far fa-file-alt"></i> Media</h6>
                                        <ul class="list-unstyled mb-3">
                                            @foreach (var media in location.MediaReports ?? new List<MediaReport>())
                                            {
                                                <li class="mb-2">
                                                    <div class="border rounded p-2 bg-light">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="media_@media.Id" @(media.Selected ? "checked" : "") />
                                                            <label class="form-check-label" for="media_@media.Id">
                                                                <i class="far fa-file text-muted me-1"></i>

                                                                @media.ReportName
                                                                @* @if (media.IsRequired)
                                                                {
                                                                    <span class="required-asterisk" title="Required field" data-bs-toggle="tooltip">*</span>
                                                                } *@
                                                            </label>
                                                        </div>
                                                        <div class="form-check">
                                                            <span class="required-asterisk">
                                                                <input type="checkbox" title="Required field" data-bs-toggle="tooltip"
                                                                       id="ismediaRequiredCheckbox_@media.Id"
                                                                       name="media.IsRequired"
                                                                       class="form-check-input"
                                                                @(media.IsRequired ? "checked" : "") />
                                                                <label class="form-check-label small" for="ismediaRequiredCheckbox_@media.Id">
                                                                    Is Mandatory Media ?
                                                                </label>
                                                            </span>
                                                        </div>
                                                            <div class="mt-3">
                                                                <label class="form-label fw-bold">Camera Capture Mode</label>
                                                                <div class="d-flex">
                                                                    @foreach (CameraCaptureMode captureOption in Enum.GetValues(typeof(CameraCaptureMode)))
                                                                    {
                                                                        var radioId = $"camera_media_{media.Id}_{captureOption}";
                                                                        var isChecked = media.CameraCaptureMode == captureOption;
                                                                        <div class="form-check form-check-inline me-3">
                                                                            <input class="form-check-input"
                                                                                   type="radio"
                                                                                   id="@radioId"
                                                                                   name="media_camera_@media.Id"
                                                                                   value="@captureOption"
                                                                            @(isChecked ? "checked" : "") />
                                                                            <label class="form-check-label small" for="@radioId">
                                                                                @captureOption
                                                                            </label>
                                                                        </div>
                                                                    }
                                                                </div>
                                                                <input type="hidden" name="CameraCaptureMode" value="@media.CameraCaptureMode" />
                                                            </div>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                                <!-- Questions -->
                    <div class="row g-3 align-items-start">
                        <div class="col-md-12 border rounded p-2">
                            <div class="card h-100 shadow-sm border rounded  collapsed-card">
                                <div class="card-header bg-light">
                                    <div class="card-title  bg-light">
                                           
                                        <h6 class="text-muted"><i class="fas fa-question-circle"></i> Questions</h6>
                                            
                                    </div>
                                    <div class="card-tools">
                                        <button type="button" class="btn btn-sm btn-light border-secondary" data-card-widget="collapse">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <ul class="list-unstyled">
                                        @foreach (var question in location.Questions ?? new List<Question>())
                                        {
                                            <li class="mb-2">
                                                <div class="border rounded p-2 bg-light">
                                                    <div class="row">
                                                        <div class="col-md-11">
                                                            <span>@question.QuestionText</span>
                                                            @if (question.IsRequired)
                                                            {
                                                                <span class="required-asterisk" title="Required field" data-bs-toggle="tooltip">*</span>
                                                            }
                                                            <small class="text-muted">[@question.QuestionType]</small>
                                                            @if (question.QuestionType != "Text" && !string.IsNullOrEmpty(question.Options))
                                                            {
                                                                var options = question.Options.Split(',').Select(o => o.Trim());
                                                                <div class="mt-4">
                                                                    @foreach (var opt in options)
                                                                    {
                                                                        <span class="badge bg-light text-dark border me-1">@opt</span>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="mt-2">
                                                            <button class="btn btn-sm btn-outline-danger delete-question-btn" data-questionid="@question.Id" data-locationid="@location.Id">
                                                                <i class="fas fa-trash me-1"></i><small> Delete </small>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <div class="card-footer">
                                    <div class="row float-right">
                                        <div class="col-md-12">
                                            <button class="btn btn-sm btn-outline-success add-question-btn" data-locationid="@location.Id">
                                                <i class="fas fa-question me-1"></i> Add Question
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                             </div>
                            <!--  Buttons -->
                            <div class="card-footer">
                                <div class="row float-right">
                                    <div class="col-md-12">
                                        
                                        <button class="btn btn-sm btn-outline-success mt-4 save-location-btn" data-locationid="@location.Id" data-reporttemplateid="@Model.Id">
                                            <i class="fas fa-edit me-1"></i> Update
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger mt-4 delete-location-btn" data-locationid="@location.Id">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            </div>
			</div>
		</div>
	}
</div>
<partial name="_ReportTemplateTableModal" />