@using risk.control.system.Helpers;
@model ClientCompany

@{
	<li class="nav-item">
		<a is-active-page class="navlink-border nav-link  @Url.MakeActiveClass("Creator", "")
			@Url.MakeActiveClass("AddAssign", "")
			@Url.MakeActiveClass("Customer", "")
			@Url.MakeActiveClass("Beneficiary", "")
			@Url.MakeActiveClass("CaseActive", "")
			@Url.MakeActiveClass("CaseUpload", "")">
			<i class="nav-icon far fa-money-bill-alt"></i>
			<p class="sidebar-menu-header-label">
				CASES
				<div class="right"><i class="fas fa-angle-down"></i></div>
			</p>
		</a>
	</li>
	<li class="nav-item">
		<a is-active-page asp-controller="CaseUpload" asp-action="Uploads" class="actual-link nav-link @Url.MakeActiveClass("CaseUpload", "Uploads")">
			<i class="nav-icon fa fa-upload"></i>
			<p>
				<span class="badge badge-secondary"> UPLOAD <sub>file</sub></span>
			</p>
		</a>
	</li>
	<li class="nav-item">
		<a is-active-page asp-controller="AddAssign" asp-action="New" class="actual-link nav-link
			@Url.MakeActiveClass("AddAssign", "New")
			@Url.MakeActiveClass("AddAssign", "Add")
			@Url.MakeActiveClass("AddAssign", "Create")
			@Url.MakeActiveClass("AddAssign", "Edit")
			@Url.MakeActiveClass("Customer", "Create")
			@Url.MakeActiveClass("Customer", "Edit")
			@Url.MakeActiveClass("Beneficiary", "Create")
			@Url.MakeActiveClass("Beneficiary", "Edit")
			@Url.MakeActiveClass("Creator", "Details")
			@Url.MakeActiveClass("Creator", "EmpanelledAgencies")
			@Url.MakeActiveClass("Creator", "AgencyProfile") ">

			<i class="fas fa-random nav-icon"></i>
			<p>
				<span class="badge badge-warning">ADD/ASSIGN</span>
			</p>
		</a>
	</li>

	<li class="nav-item">
		<a is-active-page asp-controller="CaseActive" asp-action="Active" class="actual-link nav-link @Url.MakeActiveClass("CaseActive", "Active")
			@Url.MakeActiveClass("CaseActive", "ActiveDetail") ">
			<i class="fa fa-toggle-on nav-icon"></i>
			<p>
				<span class="badge badge-primary">ACTIVE</span>
			</p>
		</a>
	</li>
	@if (System.Diagnostics.Debugger.IsAttached)
	{
		<li class="nav-item">
			<a is-active-page class="navlink-border nav-link  
				@Url.MakeActiveClass("Claim", "")">
				<i class="nav-icon far fa-money-bill-alt"></i>
				<p class="sidebar-menu-header-label">
					CLAIMS
					<div class="right"><i class="fas fa-angle-down"></i></div>
				</p>
			</a>
		</li>
		<li class="nav-item">
			<a is-active-page asp-controller="Claim" asp-action="Add" class="actual-link nav-link @Url.MakeActiveClass("Claim", "Add")">
				<i class="fas fa-clipboard nav-icon"></i>
				<p>
					Add Claim
				</p>
			</a>
		</li>
		<li class="nav-item">
			<a is-active-page asp-controller="Claim" asp-action="Assign" class="actual-link nav-link
				@Url.MakeActiveClass("Claim", "Assign")
				@Url.MakeActiveClass("Claim", "EmpanelledAgencies")
				@Url.MakeActiveClass("Claim", "AgencyProfile")
				@Url.MakeActiveClass("Claim", "Edit")">
				<i class="fas fa-random nav-icon"></i>
				<p>
					Assign
				</p>
			</a>
		</li>
		<li class="nav-item">
			<a is-active-page asp-controller="Claim" asp-action="Active" class="actual-link nav-link
				@Url.MakeActiveClass("Claim", "Active")">
				<i class="fa fa-toggle-on nav-icon"></i>
				<p>
					Active
				</p>
			</a>
		</li>
		<li class="nav-item">
			<a is-active-page class="navlink-border nav-link  
				@Url.MakeActiveClass("Underwriting", "")">
				<i class="nav-icon far fa-money-bill-alt"></i>
				<p class="sidebar-menu-header-label">
					UNDERWRITINGS
					<div class="right"><i class="fas fa-angle-down"></i></div>
				</p>
			</a>
		</li>
		<li class="nav-item">
			<a is-active-page asp-controller="Underwriting" asp-action="Add" class="actual-link nav-link @Url.MakeActiveClass("Underwriting", "Add")">
				<i class="fas fa-clipboard nav-icon"></i>
				<p>
					Add Underwriting
				</p>
			</a>
		</li>
		<li class="nav-item">
			<a is-active-page asp-controller="Underwriting" asp-action="Assign" class="actual-link nav-link
				@Url.MakeActiveClass("Underwriting", "Assign")
					@Url.MakeActiveClass("Underwriting", "Edit")">
				<i class="fas fa-random nav-icon"></i>
				<p>
					Assign
				</p>
			</a>
		</li>
		<li class="nav-item">
			<a is-active-page asp-controller="Underwriting" asp-action="Active" class="actual-link nav-link
				@Url.MakeActiveClass("Underwriting", "Active")">
				<i class="fa fa-toggle-on nav-icon"></i>
				<p>
					Active
				</p>
			</a>
		</li>
	}
}