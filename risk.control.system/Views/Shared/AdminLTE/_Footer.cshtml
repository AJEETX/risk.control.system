@using risk.control.system.StartupExtensions
@{
	var utcTime = DeploymentInfoHelper.GetServerLocalDeploymentTime();
}
<footer class="main-footer text-sm no-print">

	<div class="float-right d-none d-sm-block">
		<a href="https://hostedscan.com" target="_blank"><img class="hostedscan" src="~/img/hostedscan.png" alt="HostedScan | An automated vulnerability scanner" /></a>
	</div>
	<span class="info-item footer-item"><i class="fas fa-globe"></i> <span class="info-title">copyright&copy; </span> <span class="info-title"><strong> @Applicationsettings.WEBSITE_NAME</strong></span></span>
	@* <span id="city" class="info-item footer-item"><i class="fas fa-city"></i> <span class="info-title"></span><b> <span class="info-data badge badge-light">Loading...</span></b></span> *@
	<span id="browser" class="info-item footer-item" title="browser"><i class="fas fa-tv"></i> <span class="info-data  badge badge-light">Loading...</span></span>
	<span id="device" class="info-item footer-item" title="device type"><i class="fa fa-laptop"></i> <span class="info-data  badge badge-light">Loading...</span></span>
	<span id="os" class="info-item footer-item" title="operating system"><i class="fas fa-hdd"></i>  <span class="info-data  badge badge-light">Loading...</span></span>
	<span class="info-item footer-item" title="deployed time"> <i class="fa fa-share-alt"></i> <span class="info-data  badge badge-light">@utcTime</span></span>
</footer>