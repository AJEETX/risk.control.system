@model ScheduleResponse

<div class="container-fluid py-3">
    <div class="card shadow-sm border-1 rounded-lg direct-chat-warning collapsed-card">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                🤝 Meeting Notification
            </h5>
            <div class="card-tools d-flex align-items-center gap-2">
                <span class="bg-light text-secondary border px-2 py-1 rounded-pill" data-bs-toggle="tooltip" title="Meeting Notification">
                    @if (Model != null)
                    {
                        <i class="fas fa-bell ring-bell"></i>
                    }
                    else
                    {
                        <i class="far fa-bell"></i>
                    }
                </span>
                <button type="button" class="btn btn-sm btn-light border-secondary" data-card-widget="collapse">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>

        <div class="card-body py-2">
            @if (Model != null)
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Requested Date & Time</th>
                                <th scope="col" class="text-center">Assigned Agent</th>
                                <th scope="col" class="text-center">
                                    @if (Model.IsClaim)
                                    {
                                       <span>Beneficiary</span>
                                    }
                                    else
                                    {
                                       <span>Customer</span>
                                    }
                                    </th>
                                <th scope="col">Scheduled Date</th>
                                <th scope="col">Scheduled Time</th>
                                <th scope="col" class="ps-3">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                
                                <td>
                                       <span class="bg-light text-dark border px-2 py-1"> @Model.ScheduleRequestedDateTime.ToString("D") </span>
                                    <span class="bg-light text-dark border px-2 py-1">  @Model.ScheduleRequestedDateTime.ToString("t") </span>
                                </td>
                                <!-- 2. Assigned Agent (Image on top, Name below) -->
                                <td class="text-center">
                                    <div class="d-flex flex-column align-items-center gap-1">
                                        <img src="/Document/GetUserProfileImage/@Model.AgentId" alt="@Model.AgentName" class="rounded-circle border profile-photo object-fit-cover" width="40" height="40" title="Agent: @Model.AgentName" />
                                        <strong class="bg-light text-dark border px-2 py-1">@Model.AgentName</strong>
                                    </div>
                                </td>

                                <!-- 3. Participants / Schedulee (Image on top, Name below) -->
                                <td class="text-center">
                                    <div class="d-flex flex-column align-items-center gap-1">
                                        @if (Model.IsClaim)
                                        {
                                            <img src="/Document/GetBeneficiaryDocument/@Model.ScheduleeId" alt="@Model.ScheduleeName" class="rounded-circle border profile-photo object-fit-cover" width="40" height="40" title="Customer: @Model.ScheduleeName" />
                                            <strong class="bg-light text-dark border px-2 py-1">@Model.ScheduleeName </strong>
                                        }
                                        else
                                        {
                                            <img src="/Document/GetCustomerDocument/@Model.ScheduleeId" alt="@Model.ScheduleeName" class="rounded-circle border profile-photo object-fit-cover" width="40" height="40" title="Beneficiary: @Model.ScheduleeName" />
                                            <strong class="bg-light text-dark border px-2 py-1">@Model.ScheduleeName </strong>
                                        }
                                    </div>
                                </td>

                                <!-- 4. Requested Date-->
                                
                                <td>
                                    <span class="bg-light text-dark border px-2 py-1">  @Model.ScheduledDateTime.ToString("D") </span>
                                </td>
                                <!-- 5. Scheduled Time -->
                                <td>
                                    <span class="bg-light text-dark border px-2 py-1">  @Model.ScheduledDateTime.ToString("t") </span>
                                </td>
                                <!-- 1. Status Section -->
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-light text-dark border px-2 py-1 status-icon fs-5 me-1">
                                            @if (Model.ScheduleAccepted)
                                            {
                                                <span class="success-icon-wrapper" title=" Appointment Confirmed">✓ </span>
                                            }
                                            else
                                            {
                                                <span class="pending-icon-wrapper" title="Pending">⏳</span>
                                            }
                                        </div>
                                        <div class="bg-light border px-2 py-1 @(Model.ScheduleAccepted ? "text-success" : "text-warning bg-color")">
                                            @(Model.ScheduleAccepted ? "Appointment Confirmed" : "Requested")
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="py-2 text-center text-muted">
                    <span class="small">No appointment scheduled.</span>
                </div>
            }
        </div>
    </div>
</div>