@model ScheduleResponse

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card shadow-lg border-1 rounded-lg direct-chat-warning collapsed-card">
                <div class="card-header bg-light text-white text-center">
                    <h3 class="card-title">
                        <i class="far fa-calendar-check text-primary"></i> Meeting Notification
                    </h3>

                    <div class="card-tools">
                        <span data-bs-toggle="tooltip" title="Meeting Notification" class="badge badge-light">
                            <i class="far fa-bell"></i>
                        </span>
                        <button type="button" class="btn btn-tool" data-card-widget="collapse">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>

                <div class="card-body text-center">
                        
                    @if (Model != null)
                    {
                        <div class="schedule-card">
                            <div class="card-header-section">
                                <div class="success-icon-wrapper">
                                    <span class="success-checkmark">✓</span>
                                </div>
                                <p class="subtitle">An appointment was successfully scheduled.</p>
                            </div>

                            <!-- Participants Profile Block (Side-by-Side Photos) -->
                            <div class="participants-section">
                                <!-- Schedulee Profile -->
                                <div class="participant-card">
                                    <!-- Update the URL path to match your API endpoint logic -->
                                    @if (Model.IsClaim)
                                    {
                                        <img src="/Document/GetBeneficiaryDocument/@Model?.ScheduleeId" alt="@Model!.ScheduleeName" class="profile-photo" title="Participant: @Model!.ScheduleeName" />
                                    }
                                    else
                                    {
                                        <img src="/Document/GetCustomerDocument/@Model?.ScheduleeId" alt="@Model!.ScheduleeName" class="profile-photo" title="Participant: @Model!.ScheduleeName" />
                                    }
                                    <span class="participant-label">Participant (You)</span>
                                    <h4 class="participant-name">@Model.ScheduleeName</h4>
                                </div>

                                <div class="profile-divider">🤝</div>

                                <!-- Agent Profile -->
                                <div class="participant-card">
                                    <img src="/Document/GetUserProfileImage/@Model?.AgentId" alt="@Model!.AgentName" class="profile-photo" title="Agent Name: @Model!.AgentName" />
                                    <span class="participant-label">Assigned Agent</span>
                                    <h4 class="participant-name">@Model.AgentName</h4>
                                </div>
                            </div>

                            <!-- Tabular Details Section -->
                            <table class="schedule-table">
                                <tbody>
                                    <tr>
                                        <th scope="row">Date</th>
                                        <td>@Model.ScheduledDateTime.ToString("D")</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Time</th>
                                        <td><span class="time-badge">@Model.ScheduledDateTime.ToString("t")</span></td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Policy Number</th>
                                        <td><span class="policy-number-tag">@Model.PolicyNumber</span></td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Insurance Provider</th>
                                        <td>
                                            <span class="insurer-badge">@Model.InsurerName</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="no-schedule-message">
                            <h2>No Appointment Scheduled</h2>
                            <p class="subtitle">You currently have no scheduled appointments.</p>
                        </div>
        
                    }

                </div>
            </div>
        </div>
    </div>
</div>

