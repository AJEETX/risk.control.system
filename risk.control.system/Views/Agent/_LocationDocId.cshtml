@model LocationReport
@{
	var location = Model;
}

@if (location.DocumentIds?.Any(d => d.Selected) == true)
{
	<div class="table-responsive mb-2">

		<table class="table table-bordered table-hover dt-responsive nowrap w-100">
		<thead class="table-light">
			<tr>
					<th scope="col" class="min-vw-25" data-toggle="tooltip" title="Document Type">
					Document Type
					</th>
					<th scope="col" class="text-center col-1" title="Scanned Document" data-toggle="tooltip">
						<i class="fas fa-copy text-muted ms-2"></i> Scanned Document
				</th>
					<th scope="col" class="min-vw-25" data-toggle="tooltip" title="Address Info">Address Info</th>
					<th title="Scanned Data" data-toggle="tooltip"><img class="action-image" src="~/headers/information.gif" />Scanned Data</th>
					<th scope="col" class="text-center col-1" data-toggle="tooltip" title="Map View">
						<img class="action-image me-2" src="~/headers/pincode.gif" alt="Map" />Map View
					</th>
					<th scope="col" class="text-center col-1" data-toggle="tooltip" title="Valid">Valid</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var doc in location.DocumentIds.Where(d => d.Selected))
			{
					<tr class="align-middle">
						<td>
							<div class="text-start mt-1 p-2 bg-white rounded bordertext-left" data-toggle="tooltip" title="Document Type">
								@doc.ReportName
								@if (doc.IsRequired)
								{
									<span class="required-asterisk" title="Mandatory Location">*</span>
								}
							</div>
							<div class="p-2 bg-white rounded border d-flex align-items-center justify-content-between shadow-sm" title="Captured Time" data-toggle="tooltip">
								<span class="badge bg-light px-2.5 py-1.5 fs-7 fw-medium">
									<i class="fas fa-clock me-1 text-dark"></i>
									<span class="local-time-display" data-utc="@(doc.LongLatTime.HasValue ? doc.LongLatTime.Value.ToString("o") : "")">
										@(doc.LongLatTime.HasValue ? "Loading..." : "--")
									</span>
								</span>
							</div>
						</td>
						<td class="text-center face-photo-column" data-doc-container="@doc.Id">
							@if (doc.ValidationExecuted && doc.DocumentFiles != null && doc.DocumentFiles.Any())
							{
								var orderedFiles = doc.DocumentFiles.OrderBy(f => f.PageNumber).ToList();
								var firstPage = orderedFiles.First().PageNumber;

								<div class="d-flex flex-column align-items-center">
									<!-- 1. Image Display Area -->
									<div class="position-relative d-inline-block mb-2">
										@foreach (var file in orderedFiles)
										{
											// If it's NOT the first page, add Bootstrap's 'd-none' class to hide it on load
											var visibilityClass = (file.PageNumber == firstPage) ? "" : "d-none";

											<img id="doc-img-@doc.Id-page-@file.PageNumber"
												 src="/Document/GetOcrDocument/@doc.Id?page=@file.PageNumber"
												 class="mobile-capture-info img-thumbnail img-fluid shadow-sm thumbnail preview-image doc-page-img-@doc.Id doc-document-thumb @visibilityClass"
												 data-page="@file.PageNumber"
												 title="Document @doc.ReportName - Page @file.PageNumber" />
										}
									</div>

									<!-- 2. Movable Page Number Links Bar -->
									@if (orderedFiles.Count > 1)
									{
										<div class="d-flex flex-wrap justify-content-center gap-1 mt-1 page-nav-bar"
										data-docid="@doc.Id"
										data-current-page="@firstPage"
										data-total-pages="@orderedFiles.Count">
											@foreach (var file in orderedFiles)
											{
												var activeClass = (file.PageNumber == firstPage) ? "btn-dark" : "btn-outline-secondary";

												<button type="button"
												class="btn btn-sm py-0 px-2 fs-8 page-nav-btn @activeClass"
												data-docid="@doc.Id"
												data-page="@file.PageNumber">
													@file.PageNumber
												</button>
											}
										</div>
									}
								</div>
							}
							else if (doc.ValidationExecuted)
							{
								<div class="position-relative d-inline-block mb-2">
									<img id="doc-img-@doc.Id"
										 src="/Document/GetOcrDocument/@doc.Id?page=1"
										 class="mobile-capture-info img-thumbnail img-fluid shadow-sm thumbnail preview-image doc-document-thumb"
										 title="Click to view document" />
								</div>
							}
							else
							{
								<img id="doc-img-@doc.Id" src="~/img/no-policy.jpg" class="thumbnail profile-image doc-profile-image doc-document-thumb" />
							}
						</td>
						<td>
							<div class="d-flex flex-column gap-2">
								<!-- Address Card -->
								<div class="text-muted  badge text-uppercase mb-1">Captured Address</div>
								<div class="p-2.5 bg-white rounded border shadow-sm">
									<div class="text-dark fs-6 fw-bold ps-1 small">@doc.LocationAddress</div>
								</div>
							</div>
						</td>
						<td>
							<div class="p-2.5 bg-white rounded border shadow-sm">
                                @foreach (var file in doc.DocumentFiles!.OrderBy(f => f.PageNumber))
                                {
                                    <div class="text-dark fs-6 fw-bold ps-1 small mb-1">
										<div class="badge bg-light text-dark border px-2 py-1 me-1">Page @file.PageNumber</div>
										<div class="bg-light text-dark border px-2 py-1 me-1">
											@file.OcrText
										</div>
                                    </div>
                                }
							</div>
						</td>
						<td class="text-center">
							@if (doc.ValidationExecuted && doc.LocationMapUrl != null)
							{
								<img id="face-img-@doc.Id"
									 src="@string.Format(@doc.LocationMapUrl, "300", "300")"
									 class="mobile-capture-map map-image"
									 data-modal-title="@doc.ReportName Image"
									 data-faceid="@doc.Id"
									 data-locationid="@location.Id"
									 data-source="document"
									 title="Click to view map" />
							}
							else
							{
								<img src="~/img/no-map.jpeg" class="thumbnail profile-image doc-profile-image" />
							}
						</td>
						<td class="text-center">
							<div class="d-flex flex-column align-items-center justify-content-center gap-1">
								@if (doc.ValidationExecuted)
								{
									if (doc.ImageValid.GetValueOrDefault())
									{
										<span class="badge bg-success-subtle text-success border border-success px-2 py-1 small">
											<i class="fas fa-check-circle me-1"></i> Valid
										</span>
									}
									else
									{
										<span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1 small">
											<i class="fa fa-times-circle me-1"></i> Invalid
										</span>
									}
								}
								else
								{
									<span class="badge bg-secondary-subtle text-muted border px-2 py-1 small">
										<i class="fa fa-minus-circle me-1"></i> Pending
									</span>
								}
							</div>
						</td>
					<td>
							<input type="file" class="form-control remarks form-control-sm doc-upload" data-docid="@doc.Id" />
							<!-- Add an input to specify the page number -->
							@if(doc.PageCount != PageCount.SINGLE)
							{
							<div class="input-group input-group-sm mt-2">
								<span class="input-group-text">Page #</span>
									@if (doc.PageCount == PageCount.DOUBLE)
									{
										<input type="number" class="form-control page-number-input" data-docid="@doc.Id" value="1" min="1" max="2" />
									}
									@if (doc.PageCount == PageCount.MULTIPLE)
									{
										<input type="number" class="form-control page-number-input" data-docid="@doc.Id" value="1" min="1"  />
									}
							</div>	
							}
							
							<button class="btn btn-sm btn-success mt-2  upload-doc-btn"
								data-docid="@doc.Id"
								data-locationid="@location.Id"
								data-location-name="@location.LocationName"
								data-name="@doc.ReportName">
							<i class="fas fa-upload"></i> Upload
						</button>
						<div id="doc-upload-status-@doc.Id" class="text-success small mt-1"></div>
					</td>
				</tr>
			}
		</tbody>
	</table>
	</div>
}
