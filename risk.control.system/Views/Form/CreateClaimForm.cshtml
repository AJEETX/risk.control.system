@model DynamicFormDesignerViewModel

<section class="content">
    <form asp-action="CreateClaimForm" method="post" id="designForm">
        <div class="card shadow-lg border-1 rounded-lg">
            <div class="card-header bg-secondary text-white text-center">
                <h3 class="card-title"><i class="fas fa-edit"></i> Create Form</h3>
            </div>
            <div class="card-body">
                <div class="submit-progress hidden">
                    <i class="fas fa-sync fa-spin fa-4x fa-fw"></i>
                </div>

                <!-- Company & Form Type Selectors at Top -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Select Client Company</label>
                        <select name="SelectedCompanyId" class="form-control" id="companySelector">
                            <option value="">-- Select Company --</option>
                            @foreach (var company in Model.Companies)
                            {
                                <option value="@company.Id" selected="@(Model.SelectedCompanyId == company.Id)">
                                    @company.Name
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Select Form Type</label>
                        <select name="TargetFormType" class="form-control" id="formTypeSelector">
                            <option value="Claim" selected="@(Model.TargetFormType == FormType.Claim)">Claim Form</option>
                            <option value="Underwriting" selected="@(Model.TargetFormType == FormType.Underwriting)">Underwriting Form</option>
                        </select>
                    </div>
                </div>

                <!-- SECTION TABS -->
                <ul class="nav nav-tabs mb-3" id="designerSections" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold section-tab-btn" data-section="Policy" type="button" role="tab">
                            <i class="bi bi-shield-shaded me-2"></i>Policy Details
                        </button>
                    </li>

                    @if (Model.TargetFormType == FormType.Underwriting)
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold section-tab-btn" data-section="LifeAssured" type="button" role="tab">
                                <i class="bi bi-person-heart me-2"></i>Life-assured Details
                            </button>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold section-tab-btn" data-section="Nominee" type="button" role="tab">
                                <i class="bi bi-person-badge me-2"></i>Nominee Details
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold section-tab-btn" data-section="ClaimDetail" type="button" role="tab">
                                <i class="bi bi-exclamation-octagon me-2"></i>Claim Details
                            </button>
                        </li>
                    }
                </ul>

                <!-- Fields Table -->
                <table class="table align-middle" id="fieldsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Label</th>
                            <th>Input Type</th>
                            <th>Dropdown Options</th>
                            <th>Required?</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="fieldsContainer">
                        @if (Model.Fields != null && Model.Fields.Any())
                        {
                            for (int i = 0; i < Model.Fields.Count; i++)
                            {
                                <tr id="row_@i" data-section="@Model.Fields[i].Section" class="field-row">
                                    <td>
                                        <input type="hidden" name="Fields[@i].CompanyId" value="@(Model.SelectedCompanyId ?? Model.Fields[i].CompanyId)" />
                                        <input type="hidden" name="Fields[@i].FormType" value="@Model.Fields[i].FormType" />
                                        <input type="hidden" name="Fields[@i].Section" value="@Model.Fields[i].Section" class="row-section-input" />
                                        <input name="Fields[@i].Label" value="@Model.Fields[i].Label" class="form-control" placeholder="Label" required />
                                    </td>
                                    <td>
                                        <select name="Fields[@i].FieldType" class="form-control field-type-select" data-index="@i">
                                            <option value="text" selected="@(Model.Fields[i].FieldType == "text")">Text</option>
                                            <option value="number" selected="@(Model.Fields[i].FieldType == "number")">Number</option>
                                            <option value="date" selected="@(Model.Fields[i].FieldType == "date")">Date</option>
                                            <option value="file" selected="@(Model.Fields[i].FieldType == "file")">File Upload</option>
                                            <option value="dropdown" selected="@(Model.Fields[i].FieldType == "dropdown")">Dropdown</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input id="options_@i" name="Fields[@i].DropdownOptions" value="@Model.Fields[i].DropdownOptions"
                                               class="form-control @(Model.Fields[i].FieldType == "dropdown" ? "" : "d-none")"
                                               placeholder="e.g. Option1, Option2" />
                                    </td>
                                    <td>
                                        <input type="checkbox" name="Fields[@i].IsRequired" value="true" class="form-check-input" @(Model.Fields[i].IsRequired ? "checked" : "") />
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm btn-remove-row" data-index="@i">Remove</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <div class="mt-3">
                    <button type="button" class="btn btn-secondary" id="btnAddField">+ Add Field </button>
                    <button type="submit" class="btn btn-success">Save Form </button>
                </div>
            </div>
        </div>
    </form>
</section>
@section Scripts {
    <script src="/js/portal-admin/form-field.js" asp-append-version="true"></script>
}