@model IEnumerable<risk.control.system.Models.SmsForCase>

@{
    ViewData["Title"] = "Sms";
}
<section class="content">
    <div id="article" class="card shadow-lg border-1 rounded-lg">
        <div class="card-header bg-secondary text-white text-center">
            <h3 class="card-title"><i class="fas fa-sms"></i> Sms for Case</h3>
        </div>
        <div class="card-body">
            <div class="submit-progress hidden">
                <i class="fas fa-sync fa-spin fa-4x fa-fw"></i>
            </div>
            <form id="antiForgeryForm">
                @Html.AntiForgeryToken()
            </form>
            <table id="dataTable" class="table table-bordered table-hover dt-responsive nowrap w-100">
                <thead>
                    <tr>
                        <th>Sender Email</th>
                        <th>Recepient </th>
                        <th>Status</th>
                        <th>Message body</th>
                        <th>Updated Time</th>
                    </tr>
                </thead>
            </table>
        </div>
        
    </div>
</section>

@section Scripts {
    <script src="~/js/company-admin/sms.js">
    </script>
}