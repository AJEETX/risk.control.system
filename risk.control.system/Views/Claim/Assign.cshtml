@{
    ViewData["Title"] = "Claims";
    var key = Environment.GetEnvironmentVariable("GOOGLE_MAP_KEY") ?? "";
}
<section class="content">
    <div id="article" class="card shadow-lg border-1 rounded-lg">
        <div class="card-header bg-secondary text-white text-center">
            <h3 class="card-title"><i class="fa fa-server"></i> Claims</h3>
        </div>
        <div class="card-body">
            <div class="submit-progress hidden">
                <i class="fas fa-sync fa-spin fa-4x fa-fw"></i>
            </div>
            <div class="card shadow border-0 p-4 rounded-3">
                <div class="table-responsive">
                    <div id="submissionsTableWrapper" data-google-maps-key="@key" class="table-responsive">
                        <table id="dataTable" class="table table-hover table-bordered w-100 m-0">
                        <thead class="table-light">
                            <tr id="tableHeaders">
                                <!-- DataTables will auto-generate headers dynamically -->
                            </tr>
                        </thead>
                    </table>
                </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="row float-right">
                <div class="col-md-12">
                    <button disabled id="allocatedcase" type="submit" class="btn btn-sm btn-warning">
                        <i class="fas fa-random"></i> Assign<sub>auto</sub>
                    </button>
                    <button disabled id="deletecase" type="submit" class="btn btn-sm btn-danger">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script src="/js/claim/assign.js" asp-append-version="true"></script>
}