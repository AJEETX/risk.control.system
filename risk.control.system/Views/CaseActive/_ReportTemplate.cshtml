@using risk.control.system.Helpers
@model ReportTemplate
<div class="row">
    <div class="col-12 text-center">
        <label for="Name">
            Template Name :
            <span class="badge badge-default">@Model.Name</span>
        </label>
    </div>
    @foreach (var location in Model.LocationReport)
    {
        var collapseId = $"collapse_{location.Id}"; // Ensure unique ID per location

        <div class="col-12">
            <div class="card h-100 shadow-sm border rounded  collapsed-card">
                <div class="card-header bg-light">
                    <h5 class="card-title">
                        <i class="fas fa-map-marker-alt me-2"></i> @location.LocationName
                        @if (location.IsRequired)
                        {
                            <span class="required-asterisk" title="Required field" data-bs-toggle="tooltip">*</span>
                        }
                    </h5>
                    <div class="card-tools">
                        <button type="button" class="btn btn-sm btn-light border-secondary" data-card-widget="collapse">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3 align-items-start">
                        <!-- Agent ID -->
                        <div class="col-md-3 border rounded p-2">
                            <h6 class="text-muted"><i class="far fa-user"></i> Agent ID</h6>
                            <ul class="list-unstyled mb-3">
                                <li class="mb-2">
                                    <div class="border rounded p-2  bg-light">
                                        <div class="form-check">
                                            <input disabled class="form-check-input" type="checkbox" id="agent_@location.AgentIdReport?.Id" @(location.AgentIdReport!.Selected ? "checked" : "") />
                                            <input type="hidden" name="AgentIdReport.Selected" value="@(location.AgentIdReport.Selected)" />
                                            <label class="form-check-label" for="agent_@location.AgentIdReport.Id">
                                                @if (location.AgentIdReport.Has2Face)
                                                {
                                                    <i class="fas fa-users text-info me-1"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-user text-info me-1"></i>
                                                }
                                                @location.AgentIdReport.ReportName
                                                @if (location.AgentIdReport.IsRequired)
                                                {
                                                    <span class="required-asterisk" title="Mandatory" data-bs-toggle="tooltip">*</span>
                                                }
                                            </label>
                                        </div>
                                        <div class="mt-3">
                                            <label class="form-label fw-bold">Camera Capture Mode</label>
                                            <div class="d-flex">
                                                @foreach (CameraCaptureMode captureOption in Enum.GetValues(typeof(CameraCaptureMode)))
                                                {
                                                    var radioId = $"camera_{location.AgentIdReport.Id}_{captureOption}";
                                                    var isChecked = location.AgentIdReport.CameraCaptureMode == captureOption;
                                                    <div class="form-check form-check-inline me-3">
                                                        <input class="form-check-input"
                                                               type="radio"
                                                               name="AgentIdReport_@(location.AgentIdReport.Id)_CameraCaptureMode"
                                                               id="@radioId"
                                                               value="@captureOption"
                                                               disabled
                                                        @(isChecked ? "checked" : "") />
                                                        <label class="form-check-label small" for="@radioId">
                                                            @captureOption
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <!-- Face IDs -->
                        <div class="col-md-3 border rounded p-2">
                            <h6 class="text-muted"><i class="far fa-user"></i> Face IDs</h6>
                            <ul class="list-unstyled mb-3">
                                @foreach (var face in location.FaceIds ?? new List<FaceIdReport>())
                                {
                                    <li class="mb-2">
                                        <div class="border rounded p-2  bg-light">
                                            <div class="form-check">
                                                <input disabled class="form-check-input" type="checkbox" id="face_@face.Id" @(face.Selected ? "checked" : "") />
                                                <label class="form-check-label" for="face_@face.Id">
                                                    @if (face.Has2Face)
                                                    {
                                                        <i class="fas fa-users text-info me-1"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-user text-info me-1"></i>
                                                    }
                                                    @face.ReportName
                                                    @if (face.IsRequired)
                                                    {
                                                        <span class="required-asterisk" title="Mandatory Face" data-bs-toggle="tooltip">*</span>
                                                    }
                                                </label>
                                            </div>
                                            <div class="mt-3">
                                                <label class="form-label fw-bold">Camera Capture Mode</label>
                                                <div class="d-flex">
                                                    @foreach (CameraCaptureMode captureOption in Enum.GetValues(typeof(CameraCaptureMode)))
                                                    {
                                                        var radioId = $"camera_face_{face.Id}_{captureOption}";
                                                        var isChecked = face.CameraCaptureMode == captureOption;
                                                        <div class="form-check form-check-inline me-3">
                                                            <input class="form-check-input"
                                                                   type="radio"
                                                                   id="@radioId"
                                                                   disabled
                                                                   name="face_camera_@face.Id"
                                                                   value="@captureOption"
                                                            @(isChecked ? "checked" : "") />
                                                            <label class="form-check-label small" for="@radioId">
                                                                @captureOption
                                                            </label>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                        <!-- Document IDs -->
                        <div class="col-md-3 border rounded p-2">
                            <h6 class="text-muted"><i class="far fa-file-alt"></i> Document IDs</h6>
                            <ul class="list-unstyled mb-3  scrollable-list">
                                @{
                                    int i = 0;
                                }
                                @foreach (var doc in location.DocumentIds ?? new List<DocumentIdReport>())
                                {
                                    <li class="mb-2">
                                        <div class="border rounded p-2 bg-light">
                                            <div class="form-check">
                                                <input disabled class="form-check-input" type="checkbox" id="doc_@doc.Id" @(doc.Selected ? "checked" : "") />
                                                <label class="form-check-label" for="doc_@doc.Id">
                                                    @if (doc.HasBackImage)
                                                    {
                                                        <i class="fas fa-copy text-muted me-1"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-file text-muted me-1"></i>
                                                    }
                                                    @doc.ReportName
                                                    @if (doc.IsRequired)
                                                    {
                                                        <span class="required-asterisk" title="Mandatory document" data-bs-toggle="tooltip">*</span>
                                                    }
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <span class="text-muted small d-block mb-1">Page Count:</span>
                                                <div class="d-flex flex-wrap gap-3">
                                                    @foreach (PageCount countOption in Enum.GetValues(typeof(PageCount)))
                                                    {
                                                        <div class="form-check form-check-inline mb-0">
                                                            <input class="form-check-input"
                                                                   type="radio"
                                                                   name="pageCount_@doc.Id.ToString()"
                                                                   id="pageCount_@doc.Id.ToString()_@countOption"
                                                                   value="@countOption"
                                                                   disabled
                                                                   checked="@(doc.PageCount == countOption)" />
                                                            <label class="form-check-label small" for="pageCount_@doc.Id.ToString()_@countOption">
                                                                @countOption.GetEnumDisplayName()
                                                            </label>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                    i++;
                                }
                            </ul>
                        </div>
                        <!-- Media IDs -->
                        <div class="col-md-3 border rounded p-2">
                            <h6 class="text-muted"><i class="far fa-file-alt"></i> Media</h6>
                            <ul class="list-unstyled mb-3">
                                @foreach (var media in location.MediaReports ?? new List<MediaReport>())
                                {
                                    <li class="mb-2">
                                        <div class="border rounded p-2 bg-light">
                                            <div class="form-check">
                                                <input disabled class="form-check-input" type="checkbox" id="media_@media.Id" @(media.Selected ? "checked" : "") />
                                                <label class="form-check-label" for="media_@media.Id">
                                                    <i class="far fa-file text-muted me-1"></i>

                                                    @media.ReportName
                                                    @if (media.IsRequired)
                                                    {
                                                        <span class="required-asterisk" title="Mandatory media" data-bs-toggle="tooltip">*</span>
                                                    }
                                                </label>
                                            </div>
                                            @if(media.MediaType == MediaType.VIDEO)
                                            {
                                                <div class="mt-3">
                                                    <label class="form-label fw-bold">Camera Capture Mode</label>
                                                    <div class="d-flex">
                                                        @foreach (CameraCaptureMode captureOption in Enum.GetValues(typeof(CameraCaptureMode)))
                                                        {
                                                            var radioId = $"camera_media_{media.Id}_{captureOption}";
                                                            var isChecked = media.CameraCaptureMode == captureOption;
                                                            <div class="form-check form-check-inline me-3">
                                                                <input class="form-check-input"
                                                                       type="radio"
                                                                       id="@radioId"
                                                                       name="media_camera_@media.Id"
                                                                       value="@captureOption"
                                                                       disabled
                                                                @(isChecked ? "checked" : "") />
                                                                <label class="form-check-label small" for="@radioId">
                                                                    @captureOption
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                        <!-- Questions -->
                        <div class="col-md-12 border rounded p-2">
                            <h6 class="text-muted"><i class="fas fa-question-circle"></i> Questions</h6>
                            <ul class="list-unstyled">
                                @foreach (var question in location.Questions ?? new List<Question>())
                                {
                                    <li class="mb-2">
                                        <div class="border rounded p-2 bg-light">
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <span>@question.QuestionText</span>
                                                    @if (question.IsRequired)
                                                    {
                                                        <span class="required-asterisk" title="Required field" data-bs-toggle="tooltip">*</span>
                                                    }
                                                    <small class="text-muted">[@question.QuestionType]</small>
                                                    @if (question.QuestionType != "Text" && !string.IsNullOrEmpty(question.Options))
                                                    {
                                                        var options = question.Options.Split(',').Select(o => o.Trim());
                                                        <div class="mt-4">
                                                            @foreach (var opt in options)
                                                            {
                                                                <span class="badge bg-light text-dark border me-1">@opt</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
