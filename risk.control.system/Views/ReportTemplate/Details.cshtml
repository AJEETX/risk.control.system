@model ReportTemplate

<section class="content">
    <div id="article" class="card shadow-lg border-1 rounded-lg">
        <div class="card-header bg-secondary text-white text-center">
            <h3 class="card-title">
                <i class="far fa-file-powerpoint"></i> Details <sub>(@Model.InsuranceType)</sub>
                <span class="hover-text">
                    <i class="fas fa-info-circle"></i>
                    <span class="tooltip-text" id="information">
                        <li>
                            <i class='fas fa-copy'></i> Clone <sub>location</sub>
                        </li>
                        <li>
                            <i class='fas fa-edit'></i>  Save<sub>location</sub>
                        </li>
                        <li>
                            <i class='fa fa-trash'></i> Delete <sub>location</sub>
                        </li>
                        <li>
                            <i class='fa fa-trash'></i> Delete <sub>question</sub>
                        </li>
                        <li>
                            <i class='fas fa-question '></i> Add <sub>question</sub>
                        </li>
                        <li>
                            <i class='fa fa-flash'></i>  Activate <sub>template</sub>
                        </li>
                    </span>
                </span>
            </h3>
        </div>
        <div class="card-body">
            <div class="submit-progress hidden">
                <i class="fas fa-sync fa-spin fa-4x fa-fw"></i>
            </div>
            <div class="row">
                <form id="antiForgeryForm">
                    @Html.AntiForgeryToken()
                </form>
                <div class="col-12 text-center">
                    <input type="hidden" id="locationCount" value="@Model.LocationReport.Count" />
                    <span>
                        Template Name:
                    </span>
                    <strong>@Model.Name (@Model.InvestigationServiceType.Name)</strong>
                </div>
                @foreach (var location in Model.LocationReport)
                {
                    <div class="col-12">
                        <div class="card h-100 shadow-sm border rounded  collapsed-card">
                            <div class="card-header bg-light">
                                <div class="card-title  location-header-width">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <span class="badge badge-light mt-2" title="Location Name" data-bs-toggle="tooltip">
                                                <i class="fas fa-map-marker-alt me-2"></i> 
                                                @if (location.IsRequired)
                                                {
                                                    <span class="required-asterisk" title="Required field" data-bs-toggle="tooltip">*</span>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-asterisk asterik-style-none"></i>
                                                }
                                            </span>
                                            <input type="text" id="@location.Id" asp-for="@location.LocationName" title="Location Name" data-bs-toggle="tooltip" class="form-control remarks title-name" required placeholder="Location Name" value="@location.LocationName" maxlength="50" />
                                            
                                            <span asp-validation-for="@location.LocationName" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-tools  location-button-mt2">
                                    <button type="button" class="btn btn-sm btn-light @location.LocationStatus" data-card-widget="collapse">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>

                            </div>
                            <div class="card-body">
                                <div class="row g-3 align-items-start">
                                    <!-- Agent ID -->
                                    <partial name="ReportTemplate/_AgentDetails" model="location" />
                                    <!-- Face IDs -->
                                    <partial name="ReportTemplate/_FaceDetails" model="location" />
                                    <!-- Document IDs -->
                                    <partial name="ReportTemplate/_DocumentDetails" model="location" />
                                    <!-- Media IDs -->
                                    <partial name="ReportTemplate/_MediaDetails" model="location" />
                                </div>
                                <!-- Questions -->
                                <partial name="ReportTemplate/_QuestionDetails" model="location" />
                             </div>
                            <!--  Buttons -->
                            <div class="card-footer">
                                <div class="row float-right">
                                    <div class="col-md-12">
                                        <button class="btn btn-sm btn-outline-secondary mt-4 clone-location-btn" data-locationid="@location.Id" data-reporttemplateid="@Model.Id">
                                            <i class="fas fa-copy me-1"></i> Clone
                                        </button>
                                        <button class="btn btn-sm btn-outline-success mt-4 save-location-btn" data-locationid="@location.Id" data-reporttemplateid="@Model.Id">
                                            <i class="fas fa-edit me-1"></i> Save
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger mt-4 delete-location-btn" data-locationid="@location.Id">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            
            </div>
        </div>
        <div class="card-footer">
            <div class="row float-right">
                <div class="col-md-12">
                    <a id="back" asp-action="Profile" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> <i class="far fa-file-powerpoint"></i> Back
                    </a>
                    @if (Model.IsActive)
                    {
                        <button disabled class="btn btn-outline-success" data-bs-toggle="tooltip" title="The template is active">
                            <i class="fas fa-flash igreen"></i><bold> Active <i class="fas fa-check-circle"></i></bold>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success activation-btn" data-id="@Model.Id">
                            <i class="fas fa-flash"></i> Activate
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<partial name="ReportTemplate/_ReportTemplateQuestionModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/company/report-template-detail.js"></script>
}